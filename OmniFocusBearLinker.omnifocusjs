/*{
  "type": "action",
  "targets": ["omnifocus"],
  "author": "qllllll",
  "identifier": "cn.sferic.omnifocus.bear-note",
  "version": "1.0.1",
  "description": "为所选任务创建带标题、标签和任务链接的 Bear 笔记，并把笔记链接追加到任务备注。已有链接时打开原笔记。",
  "label": "创建或打开 Bear 笔记",
  "shortLabel": "Bear 笔记",
  "paletteLabel": "创建或打开 Bear 笔记",
  "image": "note.text.badge.plus"
}*/
/*
SPDX-License-Identifier: MIT

